# --- PostgreSQL ---
POSTGRES_USER=nabs_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nabs_governance
DATABASE_URL=postgresql://nabs_admin:change_me@nabs-db:5432/nabs_governance

# --- Redis / Celery ---
REDIS_URL=redis://nabs-redis:6379/0

# --- Application ---
APP_ENV=production            # 'development' allows ephemeral master key (dev only!)
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
NABS_MASTER_KEY=
JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=60

# CORS: dashboard'un gerçek origin'i (virgülle ayrık). TLS arkasında https olur.
CORS_ORIGINS=http://localhost:5173

# --- Opsiyonel: HashiCorp Vault (bootstrap secret'ları) ---
# Tanımlıysa NABS_MASTER_KEY/JWT_SECRET/SFTPGO_WEBHOOK_SECRET Vault KV v2'den okunur.
# Kendi Vault'unuz: VAULT_ADDR'i ona yöneltin.
# Gömülü Vault (docker-compose.vault.yml): ./scripts/vault_init.sh bu değerleri basar.
# VAULT_ADDR=http://nabs-vault:8200      # gömülü; kendi Vault'unuz için https://vault.corp:8200
# VAULT_TOKEN=                            # ya da VAULT_ROLE_ID + VAULT_SECRET_ID (AppRole)
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PATH=nabs-gp

# --- TLS (docker-compose.tls.yml ile) ---
# NABS_DOMAIN=nabs.sirket.local

# --- SFTPGo passive ingestion ---
SFTPGO_WEBHOOK_SECRET=change_me
SFTPGO_UPLOAD_ROOT=/var/nabs/sftpgo_uploads
SFTPGO_HTTPD__BINDINGS__0__PORT=8080

# --- Git repository ---
NABS_GIT_REPO_PATH=/var/nabs/git_repo

# --- Local LLM (Ollama) — harici, stack'e gömülü DEĞİL ---
# Ollama'yı ayrı çalıştırın (Mac native app, ya da CPU/GPU sunucu).
# Docker içindeki API host'a 'host.docker.internal' ile ulaşır (Mac/Windows
# Docker Desktop'ta hazır; Linux'ta compose'daki extra_hosts sağlar).
# Backend'i Docker DIŞINDA çalıştırıyorsanız localhost kullanın.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=llama3:8b-instruct
OLLAMA_EMBED_ENDPOINT=http://host.docker.internal:11434/api/embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Faz 3: CVE eşleme ---
# NVD_API_KEY=            # opsiyonel; oran limiti için önerilir

# --- Faz 5: Bildirimler (tanımsız kanal atlanır) ---
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# SYSLOG_HOST=
# SYSLOG_PORT=514

# --- Faz 5: Opsiyonel LDAP SSO katmanı ---
# LDAP_URL=ldap://dc01:389
# LDAP_BIND_TEMPLATE=uid={username},ou=people,dc=corp,dc=local
# LDAP_DEFAULT_ROLE=viewer

# --- Bölüm 12.3: Veri saklama ---
DATA_RETENTION_DAYS=365
DB_BACKUP_RETENTION_DAYS=14

# --- Bölüm 11: Grafana ---
GF_SECURITY_ADMIN_PASSWORD=change_me
