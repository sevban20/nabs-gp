# Caddy ile otomatik HTTPS (Let's Encrypt) TLS terminasyonu.
# {$NABS_DOMAIN} env'den gelir (ör. nabs.sirket.local ya da gerçek FQDN).
# Gerçek sertifika için herkese açık bir FQDN + 80/443 erişimi gerekir;
# iç ağ için 'tls internal' satırını açıp self-signed kullanın.

{$NABS_DOMAIN} {
    # TLS modu NABS_TLS_MODE ile belirlenir (docker-compose.tls.yml → environment):
    #   boş           → otomatik HTTPS (Let's Encrypt). Herkese açık FQDN + 80/443 şart.
    #   tls internal  → Caddy'nin kendi CA'sı ile self-signed. İç alan adları
    #                   (.local, .lan, .internal …) için TEK seçenek — Let's Encrypt
    #                   bu adlara sertifika veremez.
    # install.sh iç alan adı tespit ettiğinde bunu kendiliğinden 'tls internal' yapar.
    {$NABS_TLS_MODE}

    encode gzip

    # API isteklerini backend'e
    handle /api/* {
        reverse_proxy nabs-core-api:8000
    }

    # Diğer her şey dashboard'a (SPA)
    handle {
        reverse_proxy nabs-dashboard:80
    }
}
